# Copy to .env and fill in. NEVER commit .env.
PORT=8080
# From the dashboard ("Rotate Secret"), shown exactly once.
AGENT_GAMES_HMAC_SECRET=
# HMAC signature format: hex (default) or sha256=
AGENT_GAMES_HMAC_FORMAT=hex
# Strategy game numbers — calibrate from practice (see README + simulator).
FORTIFY_COST=2
EXTRACT_CAP=10
PROTECTED_FRACTION=0.5
# Policy knobs (see steal/strategy.js).
FORTIFY_MIN_LEAD=5
FORTIFY_LATE_TURN=15
EXTRACT_MIN_EXPOSED=1
# Strategy commitment (see steal/proof.js). Salt: openssl rand -hex 16.
STEAL_STRATEGY_PARAMS=
STEAL_STRATEGY_SALT=
CIRCUIT_VERSION=vfy-policy-v1
