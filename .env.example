# Copy to .env and fill in. NEVER commit .env.
PORT=8080
# From the dashboard ("Rotate Secret"), shown exactly once.
AGENT_GAMES_HMAC_SECRET=
# HMAC signature format: hex (default) or sha256=
AGENT_GAMES_HMAC_FORMAT=hex
# Strategy game numbers — OFFICIAL (agentgames.zkverify.io/build).
FORTIFY_COST=2
EXTRACT_CAP=10
FORTIFY_BLOCK=6
# Policy knobs (see steal/strategy.js).
FORTIFY_MIN_LEAD=5
FORTIFY_LATE_TURN=15
EXTRACT_MIN_EXPOSED=1
# Strategy commitment — UNVERIFIED (see steal/proof.js): the platform
# freezes the POLICY CIRCUIT hash (vkHash), not params+salt. Salt kept
# only for comparison once the dashboard shows the expected commitment.
STEAL_STRATEGY_PARAMS=
STEAL_STRATEGY_SALT=
CIRCUIT_VERSION=v1
